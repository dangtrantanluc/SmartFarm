<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartFarm.ViewModels"
             x:DataType="vm:WeatherViewModel"
             x:Class="SmartFarm.Views.MainPage">
    
    <ScrollView>
        <!--cuộn màn hình-->
        <VerticalStackLayout>
            <!--sắp xếp các phần tử con theo chiều dọc-->

            
            <!-- Header màu xanh -->
            <Grid
                BackgroundColor="#2E9E43"
                Padding="20"
                RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="*,Auto"> <!-- lưới có 3 hàng, 2 cột-->

                <!-- Thông tin người dùng -->
                <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid
                            BackgroundColor="#2E9E43"
                            Padding="5"
                            ColumnDefinitions="Auto,*, Auto">

                            <Frame
                                Grid.Column="0"
                                WidthRequest="45"
                                HeightRequest="45"
                                CornerRadius="50"
                                HasShadow="False"
                                BorderColor="White"
                                BackgroundColor="Transparent">

                                <Image Source="avatar.jpg"
                                   Aspect="AspectFill"
                                   WidthRequest="50"
                                   HeightRequest="50" />
                            </Frame>
                        
                            <!-- Thông tin người dùng (cột 1) -->
                            <StackLayout
                                Grid.Column="1"
                                Padding="10,0,0,0">
                                <Label Text="Mr. MyFarm"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="Demo Farm"
                                       FontSize="14"
                                       TextColor="White"/>
                            </StackLayout>

                            <ImageButton
                                 Grid.Column="2"
                                 Source="chatbot.png"
                                 WidthRequest="38"
                                 HeightRequest="38"
                                 BackgroundColor="Transparent"
                                 HorizontalOptions="End"
                                 VerticalOptions="Center"
                                 Clicked="OnChatbotClicked"/>
                    </Grid>
                </StackLayout>
                <!-- Khung chat bot -->
               
                <!-- Ngày tháng -->
                <Label Grid.Row="1" Grid.ColumnSpan="2"
                       Text="{Binding CurrentDate}"
                       FontSize="18"
                       TextColor="White"
                       Margin="0,10,10,0"/>

                <!-- Dòng thời tiết -->
                <Grid Grid.Row="2" Grid.ColumnSpan="3"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="5">

                    <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="5">
                        <Image Source="{Binding Icon}" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="{Binding Temperature}" TextColor="White" FontSize="15"/>
                    </StackLayout>

                    <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Label Text="{Binding WindSpeed}" TextColor="White" FontSize="15"/>
                    </StackLayout>

                    <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="5">
                        <Label Text="{Binding Humidity}" TextColor="White" FontSize="15"/>
                    </StackLayout>

                </Grid>
            </Grid>

            <!-- Nội dung khác bên dưới -->
            
            <Label Text="📰 Tin tức Nông nghiệp mới nhất"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="DarkGreen"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

            <!-- Khu vực hiển thị bài báo -->
            <StackLayout x:Name="NewsContainer"
                         Margin="10,0,10,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>