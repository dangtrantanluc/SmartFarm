<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartFarm.Views.TakeNotePage"
             Title="TakeNotePage">
	<ScrollView>
		<VerticalStackLayout
            Padding="20,0"
            Spacing="10">
			<!-- Thanh tìm kiếm -->
			<SearchBar Placeholder="Search" Text="{Binding SearchText}" />

			<!-- Danh sách công việc -->
			<CollectionView ItemsSource="{Binding FilteredNotes}">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<Frame BackgroundColor="White" CornerRadius="10" Padding="10" Margin="5">
							<HorizontalStackLayout>
								<CheckBox IsChecked="{Binding IsDone}" />
								<Label Text="{Binding Content}" FontSize="18" VerticalOptions="Center">
									<Label.Triggers>
										<DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
											<Setter Property="TextDecorations" Value="Strikethrough" />
											<Setter Property="TextColor" Value="Gray" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
							</HorizontalStackLayout>
						</Frame>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Editor x:Name="NoteEntry"
                Placeholder="Add a new todo item"
                AutoSize="TextChanges"
                MaxLength="500"
                BackgroundColor="White"
                TextChanged="OnTextChanged"
                Unfocused="OnEditorUnfocused"/>

			<!-- Ô nhập và nút thêm công việc -->
			<Grid Padding="10">
				<Button Text="+" BackgroundColor="#6C63FF" TextColor="White"
                    Clicked="OnAddNote"
                    WidthRequest="50" HeightRequest="50"
                    CornerRadius="25" FontSize="24"
                    HorizontalOptions="End"/>
			</Grid>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>